{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post"
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "metadatas": {
        "label": "Title"
      }
    },
    "acf": {
      "type": "json",
      "metadatas": {
        "label": "Acf"
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "metadatas": {
        "label": "Slug"
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "metadatas": {
        "label": "Seo"
      }
    },
    "excerpt": {
      "type": "richtext",
      "metadatas": {
        "label": "Excerpt"
      }
    },
    "content": {
      "type": "richtext",
      "metadatas": {
        "label": "Content"
      }
    },
    "layout": {
      "type": "text",
      "metadatas": {
        "label": "Layout"
      }
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "metadatas": {
        "label": "Featured Image"
      }
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "posts",
      "metadatas": {
        "label": "Categories"
      }
    },
    "wpPostIds": {
      "type": "string",
      "help": "Comma-separated WordPress post IDs to display data from (e.g., 40,81,101)",
      "metadatas": {
        "label": "Wp Post Ids"
      }
    },
    "displayWpData": {
      "type": "boolean",
      "default": false,
      "help": "Enable to fetch and display WordPress post data",
      "metadatas": {
        "label": "Display Wp Data"
      }
    }
  }
}
